#!/bin/bash

# ───────────── CONFIGURATION ─────────────

# Default values
EXEGOL_PATH='/usr/local/bin/exegol'
REPO_DIR="/exu/exegol-images"
REPO_URL="https://github.com/ThePorgs/Exegol-images.git"
BRANCH="dev"
BUILD_PROFILE="full" # full=nightly on dev branch
IMAGE_NAME="server$BUILD_PROFILE"

# Options management
FORCE_MODE=false
BUILD_ONLY_MODE=false

for arg in "$@"; do
    case "$arg" in
        --debug)
            REPO_URL="https://github.com/Goultarde/Exegol-images"
            BRANCH="main"
            BUILD_PROFILE="light"
            IMAGE_NAME="server$BUILD_PROFILE"
            echo "[DEBUG] Debug mode enabled: Goultarde repo, main branch, light profile (-100MB)."
            ;;
        --force)
            FORCE_MODE=true
            echo "[FORCE] Force mode enabled: forced build even without a new commit."
            ;;
        --build-only)
            BUILD_ONLY_MODE=true
            ;;
        -h|--help)
            echo "Usage : $0 [--debug] [--force] [--build-only] [-h|--help]"
            echo
            echo "  --debug      Uses Goultarde repo, main branch, light profile (test mode)"
            echo "  --force      Forces the build even if no new commit is detected"
            echo "  --build-only Build only, without tar export or image/container deletion"
            echo "  -h, --help   Displays this help"
            exit 0
            ;;
        *) ;;
    esac
done

TARPATH="/exu/exegol-update-server/exu-tars"
TAR_OUTPUT="${TARPATH}/exegol-${BUILD_PROFILE}-$(date +%Y%m%d).tar"
CHECKSUM_FILE="${TARPATH}/latest_commit.hash"
LOGPATH=/exu/exegol-update-server/exu-logs
LOGFILE="${LOGPATH}/exu_$(date '+%F_%T').log"

# Create directories with correct permissions
mkdir -p "$LOGPATH"
mkdir -p "$TARPATH"
chmod 755 "$LOGPATH"
chmod 755 "$TARPATH"

# ───────────── LOGGER ─────────────

log() {
    echo "[$(date '+%F %T')] $*" | tee -a "$LOGFILE"
}

# ───────────── CLONE/UPDATE REPO ─────────────

update_repo() {
    if [ ! -d "$REPO_DIR" ]; then
        log "Cloning Exegol-images repository..."
        git clone --branch "$BRANCH" "$REPO_URL" "$REPO_DIR"
    else
        log "Pulling latest changes..."
        cd "$REPO_DIR" && git fetch origin "$BRANCH" && git reset --hard origin/"$BRANCH"
    fi
}

# ───────────── DETECT CHANGES ─────────────

detect_changes() {
    cd "$REPO_DIR" || exit 1
    LATEST_COMMIT=$(git rev-parse HEAD)
    if [ -f "$CHECKSUM_FILE" ]; then
        PREV_COMMIT=$(cat "$CHECKSUM_FILE")
        if [ "$LATEST_COMMIT" = "$PREV_COMMIT" ] && [ "$FORCE_MODE" = false ]; then
            log "No updates found on dev branch. Exiting."
            exit 0
        elif [ "$FORCE_MODE" = true ]; then
            log "Force mode enabled: building despite no new commits detected."
        fi
    fi
    echo "$LATEST_COMMIT" > "$CHECKSUM_FILE"
}

# ───────────── BUILD IMAGE ─────────────

build_exegol() {
    log "Starting Exegol build for profile: $BUILD_PROFILE"

    # Force the export directory to exist
    mkdir -p "$(dirname "$CHECKSUM_FILE")"
    echo "$LATEST_COMMIT" > "$CHECKSUM_FILE"

    # Create the log file if it doesn't exist
    touch "$LOGFILE"
    chmod 644 "$LOGFILE"

    # Automatic call with profile
    "$EXEGOL_PATH" build $IMAGE_NAME $BUILD_PROFILE --build-path "$REPO_DIR/" --build-log "$LOGFILE" || {
        log "Build failed!"
        exit 1
    }
}


# ───────────── EXPORT IMAGE ─────────────

export_image() {
    mkdir -p "$(dirname "$TAR_OUTPUT")"
    
    # Clean up old .tar files with the same prefix
    TAR_PREFIX="exegol-${BUILD_PROFILE}"
    OLD_TARS=$(find "$TARPATH" -name "${TAR_PREFIX}-*.tar" -type f)
    if [[ -n "$OLD_TARS" ]]; then
        log "Cleaning up old .tar files:"
        echo "$OLD_TARS" | while read -r old_tar; do
            log "  Deleting: $(basename "$old_tar")"
            rm -f "$old_tar"
        done
    fi
    
    docker save -o "$TAR_OUTPUT" "nwodtuhs/exegol:$IMAGE_NAME"
    chmod -R o+r $TARPATH
    log "Docker image saved to $TAR_OUTPUT"
    # Delete local image after export
    docker rmi "nwodtuhs/exegol:$IMAGE_NAME" >/dev/null && log "Local image nwodtuhs/exegol:$IMAGE_NAME deleted after export."
}

# ───────────── RUN WRAPPER ─────────────

main() {
    pipx upgrade exegol -f
    update_repo
    detect_changes
    build_exegol
    if [ "$BUILD_ONLY_MODE" = false ]; then
        export_image
    fi
    log "✅ Exegol update pipeline completed."
}

main

