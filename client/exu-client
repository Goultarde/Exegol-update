#!/bin/bash

# ────────────── CONFIGURATION ──────────────

SERVER_URL="http://exegol.update"
DEST_DIR="/exu/exegol-update-client"
DEFAULT_REPO="nwodtuhs/exegol"
NEW_IMAGE_NAME="FreeNightly"

# ────────────── COLORS ──────────────

BLUE="\033[1;34m"
GREEN="\033[1;32m"
RED="\033[1;31m"
YELLOW="\033[1;33m"
RESET="\033[0m"

info()    { echo -e "${BLUE}[*]${RESET} $1"; }
success() { echo -e "${GREEN}[+]${RESET} $1"; }
error()   { echo -e "${RED}[-]${RESET} $1"; }
prompt()  { echo -ne "${YELLOW}[?]${RESET} $1"; }

# ────────────── HELP ──────────────

manual() {
    echo -e "${BLUE}[*]${RESET} Usage: $0 [options]\n"
    echo -e "${GREEN}DESCRIPTION${RESET}"
    echo -e "  This script automatically loads Exegol Docker images in .tar format"
    echo -e "  from an HTTP server (Nginx) or an already downloaded local file.\n"
    echo -e "${GREEN}AVAILABLE OPTIONS${RESET}"
    echo -e "  ${YELLOW}--list, -l${RESET}           Lists available .tar files on the server"
    echo -e "  ${YELLOW}--force, -f${RESET}          Forces download even if the file is already present"
    echo -e "  ${YELLOW}--load-only${RESET}          Loads a local .tar without contacting the server"
    echo -e "  ${YELLOW}--tag=[name:tag||tag]${RESET} Re-tags the image after loading (valid formats: name:tag or tag only)"
    echo -e "  ${YELLOW}--auto, -a${RESET}           Enables automatic mode"
    echo -e "  ${YELLOW}--server=[URL]${RESET}       Changes server URL (format: http://HOST[:PORT])"
    echo -e "  ${YELLOW}--check-commit${RESET}       Checks and displays if a new commit is available"
    echo -e "  ${YELLOW}-h, --help${RESET}           Displays this help"
    exit 0
}

# ────────────── PARSING ──────────────

LIST_MODE=false
FORCE_MODE=false
LOAD_ONLY_MODE=false
AUTO_MODE=false
CHECK_COMMIT_MODE=false
TAG_NAME=""
CUSTOM_SERVER_URL=""

for arg in "$@"; do
    case "$arg" in
        --list|-l) LIST_MODE=true ;;
        --force|-f) FORCE_MODE=true ;;
        --load-only) LOAD_ONLY_MODE=true ;;
        --auto|-a) AUTO_MODE=true ;;
        --check-commit) CHECK_COMMIT_MODE=true ;;
        --tag=*) TAG_NAME="${arg#*=}" ;;
        --server=*) CUSTOM_SERVER_URL="${arg#*=}" ;;
        -h|--help) manual ;;
        *) ;;
    esac
done

# ────────────── SERVER URL VALIDATION ──────────────

if [[ -n "$CUSTOM_SERVER_URL" ]]; then
    # URL format validation (accepts IP and domain names, optional port)
    if [[ "$CUSTOM_SERVER_URL" =~ ^https?://[a-zA-Z0-9.-]+(:[0-9]+)?/?$ ]]; then
        SERVER_URL="$CUSTOM_SERVER_URL"
        
        # Add default port if no port is specified
        if [[ "$SERVER_URL" =~ ^https?://[a-zA-Z0-9.-]+/?$ ]]; then
            if [[ "$SERVER_URL" =~ ^https:// ]]; then
                SERVER_URL="${SERVER_URL%?}/:443/"
                info "Default port added (443)"
            else
                SERVER_URL="${SERVER_URL%?}/:80/"
                info "Default port added (80)"
            fi
        fi
        
        # Ensure URL ends with /
        [[ "$SERVER_URL" != */ ]] && SERVER_URL="${SERVER_URL}/"
        info "Custom server configured: $SERVER_URL"
    else
        error "Invalid URL format. Use format: http://HOST[:PORT] or https://HOST[:PORT]"
        error "Examples: --server=http://192.168.1.100:9000"
        error "          --server=https://exegol-server.local:8443"
        error "          --server=http://exegol.example.com (default port 80)"
        error "          --server=https://exegol.example.com (default port 443)"
        exit 1
    fi
fi

# ────────────── COMMIT CHECK ──────────────

if $CHECK_COMMIT_MODE; then
    info "Checking for new commits on the server..."
    
    # Retrieve the latest commit hash from the server
    SERVER_COMMIT_HASH=$(curl -s "$SERVER_URL/latest_commit.hash")
    
    if [[ -z "$SERVER_COMMIT_HASH" ]]; then
        error "Unable to retrieve the latest commit hash from the server."
        exit 1
    fi
    
    # Check if we have a local hash file
    LOCAL_HASH_FILE="$DEST_DIR/latest_commit.hash"
    if [[ -f "$LOCAL_HASH_FILE" ]]; then
        LOCAL_COMMIT_HASH=$(cat "$LOCAL_HASH_FILE")
        
        if [[ "$SERVER_COMMIT_HASH" = "$LOCAL_COMMIT_HASH" ]]; then
            echo -e "${RED}[-]${RESET} No new commit"
        else
            echo -e "${GREEN}[+]${RESET} New commit available"
        fi
    else
        echo -e "${GREEN}[+]${RESET} New commit available"
    fi
    
    # If we only have --check-commit, we stop here
    # Otherwise we continue to display the list or download
    if [[ "$CHECK_COMMIT_MODE" = true && "$LIST_MODE" = false && "$FORCE_MODE" = false && "$LOAD_ONLY_MODE" = false ]]; then
        exit 0
    fi
    
    echo
fi

mkdir -p "$DEST_DIR"

# ────────────── LOAD-ONLY MODE ──────────────

if $LOAD_ONLY_MODE; then
    info "--load-only mode enabled: searching for local files in $DEST_DIR"
    LOCAL_TARS=$(find "$DEST_DIR" -type f -name '*.tar' | sort)
    if [ -z "$LOCAL_TARS" ]; then
        error "No .tar file found locally."
        exit 1
    fi

    echo
    info "Locally available files:"
    echo "$LOCAL_TARS" | nl -w2 -s'. '
    if ! $AUTO_MODE; then
        prompt "Which file do you want to load? (number): "
        read -r INDEX
    else
        INDEX=1
        info "Auto mode: selecting the first file ($INDEX)"
    fi
    SELECTED_LOCAL=$(echo "$LOCAL_TARS" | sed -n "${INDEX}p")

    if [[ -z "$SELECTED_LOCAL" ]]; then
        error "Invalid selection."
        exit 1
    fi

    info "Loading $(basename "$SELECTED_LOCAL")..."
    LOAD_OUT=$(docker load -i "$SELECTED_LOCAL" 2>&1) || {
        error "docker load failed."; exit 1;
    }
    success "Docker image loaded."
    echo "$LOAD_OUT"

    LOADED_NAME=$(echo "$LOAD_OUT" | grep 'Loaded image:' | awk -F': ' '{print $2}')
    if [[ -z "$TAG_NAME" ]]; then
        TAG_NAME="${DEFAULT_REPO}:$NEW_IMAGE_NAME"
        info "No tag specified. Using default: $TAG_NAME"
    elif [[ "$TAG_NAME" != */* && "$TAG_NAME" != *:* ]]; then
        TAG_NAME="${DEFAULT_REPO}:${TAG_NAME}"
    fi

    if docker image inspect "$TAG_NAME" &>/dev/null; then
        if ! $AUTO_MODE; then
            prompt "Image $TAG_NAME exists. Delete? (y/N): "
            read -r CONFIRM
        else
            CONFIRM=Y
            info "Auto mode: deleting existing image ($TAG_NAME)"
        fi
        [[ "$CONFIRM" =~ ^[Yy]$ ]] && docker image rm "$TAG_NAME" &>/dev/null && success "Image deleted: $TAG_NAME" || {
            error "Aborting."; exit 1;
        }
    fi

    if [[ -n "$LOADED_NAME" ]]; then
        docker tag "$LOADED_NAME" "$TAG_NAME"
        docker image rm "$LOADED_NAME" &>/dev/null
        success "Retagged: $TAG_NAME"
    fi
    exit 0
fi

# ────────────── SERVER MODE ──────────────

info "Retrieving .tar files from the server..."
FILE_LIST=$(curl -s "$SERVER_URL/" | grep -oP 'href="[^"]+\.tar"' | cut -d'"' -f2)

[[ -z "$FILE_LIST" ]] && { error "No .tar found."; exit 1; }

if $LIST_MODE; then
    echo
    info "Available files on server:"
    echo "$FILE_LIST" | nl -w2 -s'. '
    if ! $AUTO_MODE; then
        prompt "Selection (number): "
        read -r INDEX
    else
        INDEX=1
        info "Auto mode: selecting the first file ($INDEX)"
    fi
    SELECTED=$(echo "$FILE_LIST" | sed -n "${INDEX}p")
    [[ -z "$SELECTED" ]] && { error "Invalid selection."; exit 1; }
    TAR_NAME=$(basename "$SELECTED")
else
    TAR_NAME=$(basename $(echo "$FILE_LIST" | sort -r | head -n 1))
    info "Latest available file: $TAR_NAME"
fi

TAR_URL="$SERVER_URL/$TAR_NAME"
LOCAL_PATH="$DEST_DIR/$TAR_NAME"

if [[ -f "$LOCAL_PATH" && "$FORCE_MODE" = false ]]; then
    info "File $TAR_NAME is already present locally."
    info "No download will be performed."
    exit 0
else
    if ! $AUTO_MODE; then
        prompt "Do you want to download and load this file? (Y/n): "
        read -r YES
    else
        YES=Y
        info "Auto mode: automatic download."
    fi
    [[ -n "$YES" && ! "$YES" =~ ^[Yy]$ ]] && { info "Download cancelled."; exit 0; }

    info "Downloading $TAR_NAME..."
    curl -fSL "$TAR_URL" -o "$LOCAL_PATH" || {
        error "Download failed."; exit 1;
    }
    success "Download complete."
    
    # Update local commit hash
    curl -s "$SERVER_URL/latest_commit.hash" -o "$DEST_DIR/latest_commit.hash" 2>/dev/null || {
        info "Unable to retrieve commit hash (non-critical)"
    }
fi

info "Loading Docker image from $TAR_NAME..."
LOAD_OUT=$(docker load -i "$LOCAL_PATH" 2>&1) || {
    error "docker load failed."; exit 1;
}
echo "$LOAD_OUT"
success "Docker image loaded."

LOADED_NAME=$(echo "$LOAD_OUT" | grep 'Loaded image:' | awk -F': ' '{print $2}')
if [[ -z "$TAG_NAME" ]]; then
    TAG_NAME="${DEFAULT_REPO}:$NEW_IMAGE_NAME"
    info "No tag specified. Using default: $TAG_NAME"
elif [[ "$TAG_NAME" != */* && "$TAG_NAME" != *:* ]]; then
    TAG_NAME="${DEFAULT_REPO}:${TAG_NAME}"
fi

if docker image inspect "$TAG_NAME" &>/dev/null; then
    if ! $AUTO_MODE; then
        prompt "Image $TAG_NAME exists. Delete? (y/N): "
        read -r CONFIRM
    else
        CONFIRM=Y
        info "Auto mode: deleting existing image ($TAG_NAME)"
    fi
    [[ "$CONFIRM" =~ ^[Yy]$ ]] && docker image rm "$TAG_NAME" &>/dev/null && success "Image deleted: $TAG_NAME" || {
        error "Aborting."; exit 1;
    }
fi

if [[ -n "$LOADED_NAME" ]]; then
    docker tag "$LOADED_NAME" "$TAG_NAME"
    docker image rm "$LOADED_NAME" &>/dev/null
    success "Retagged: $TAG_NAME"
fi

if ! $AUTO_MODE; then
    prompt "Delete file $TAR_NAME? (y/N): "
    read -r CONFIRM_DELETE
else
    CONFIRM_DELETE=N
    info "Auto mode: file is kept."
fi
[[ "$CONFIRM_DELETE" =~ ^[Yy]$ ]] && rm -f "$LOCAL_PATH" && success "File deleted." || info "File kept."

